import numpy as np


def ReLu(x):
    return np.maximum(0, x)


class Capa:
    def __init__(self, entradas, neuronas, activacion=None, bias=False):
        self.entradas = entradas
        self.neuronas = neuronas
        self.activacion = activacion
        self.bias = bias

        self.pesos = np.random.randn(entradas, neuronas)

        if bias:
            self.b = np.random.randn(1, neuronas)
        else:
            self.b = None


    def feed_forward(self, X):
        self.entrada = X
        self.z = X @ self.pesos

        if self.bias:
            self.z += self.b

        if self.activacion is not None:
            self.salida = self.activacion(self.z)
        else:
            self.salida = self.z

        return self.salida


    def backward(self, ultima=False, error=None,
                 delta_siguiente=None, pesos_siguientes=None):

        if ultima:
            self.delta = error

        else:
            self.delta = delta_siguiente @ pesos_siguientes.T

            if self.activacion == ReLu:
                self.delta *= (self.z > 0)

        self.grad_pesos = self.entrada.T @ self.delta

        if self.bias:
            self.grad_bias = np.sum(
                self.delta,
                axis=0,
                keepdims=True
            )

        return self.delta


X = np.ones((3, 2)) * 5
y = np.zeros((3, 2))


capa1 = Capa(
    entradas=2,
    neuronas=13,
    activacion=ReLu,
    bias=True
)

capa2 = Capa(
    entradas=13,
    neuronas=2,
    activacion=None,
    bias=True
)


epocas = 100
alpha = 0.001


for epoca in range(epocas):

    # Feed Forward
    salida1 = capa1.feed_forward(X)
    resultado = capa2.feed_forward(salida1)

    # Error
    error = resultado - y

    # Perdida
    perdida = 0.5 * np.sum(error ** 2)

    # Backpropagation
    delta2 = capa2.backward(
        ultima=True,
        error=error
    )

    delta1 = capa1.backward(
        ultima=False,
        delta_siguiente=delta2,
        pesos_siguientes=capa2.pesos
    )

    # Actualizacion de pesos
    capa1.pesos -= alpha * capa1.grad_pesos
    capa2.pesos -= alpha * capa2.grad_pesos

    # Actualizacion de bias
    capa1.b -= alpha * capa1.grad_bias
    capa2.b -= alpha * capa2.grad_bias

    if epoca == 0 or (epoca + 1) % 10 == 0:
        print("Epoca:", epoca + 1, "- Perdida:", perdida)


# Resultado final
salida1 = capa1.feed_forward(X)
resultado = capa2.feed_forward(salida1)

print("\nResultado final:")
print(resultado)
